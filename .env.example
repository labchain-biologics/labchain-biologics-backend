# Application
APP_NAME=VesselChain Biologics API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://vesselchain:vesselchain@localhost:5432/vesselchain

# Google OAuth (ID token audience)
GOOGLE_CLIENT_ID=

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=vesselchain-biologics
S3_ENDPOINT_URL=http://localhost:4566
S3_PRESIGN_EXPIRE_SECONDS=3600

# AWS Batch / Nextflow hooks
AWS_BATCH_JOB_QUEUE=vesselchain-nf-queue
AWS_BATCH_JOB_DEFINITION=vesselchain-nf-job
AWS_BATCH_ENABLED=false
NEXTFLOW_WORK_DIR=s3://vesselchain-biologics/nextflow-work

# Workspace header default
DEFAULT_WORKSPACE=default

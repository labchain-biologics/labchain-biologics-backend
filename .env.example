# Application
APP_NAME=LabChain Biologics API
APP_ENV=development
DEBUG=true
SECRET_KEY=__replace_with_a_long_random_secret_key__
BOOTSTRAP_REGISTRATION_ENABLED=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_V1_PREFIX=/api/v1

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://labchain:labchain@localhost:5433/labchain

# Google OAuth (ID token audience)
GOOGLE_CLIENT_ID=

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=labchain-biologics
S3_ENDPOINT_URL=http://localhost:4566
S3_PRESIGN_EXPIRE_SECONDS=3600

# AWS Batch / Nextflow hooks
AWS_BATCH_JOB_QUEUE=labchain-nf-queue
AWS_BATCH_JOB_DEFINITION=labchain-nf-job
AWS_BATCH_ENABLED=false
NEXTFLOW_WORK_DIR=s3://labchain-biologics/nextflow-work

# Non-secret configuration of a self-hosted Titerlane Biologics API.
# Copy to .env next to compose.yaml. Secrets (SECRET_KEY, DATABASE_URL, database password)
# live in ./secrets/, never in this file. Full list: docs/configuration.md.

# Image tag to run (a released version, e.g. 0.1.0). Pin it: upgrades are explicit.
TITERLANE_VERSION=
# Host port the API listens on (loopback only).
TITERLANE_PORT=8000

APP_ENV=production
DEBUG=false
# Browser origins allowed to call the API (comma-separated), e.g. your frontend URL.
CORS_ORIGINS=
# IPs of the reverse proxy allowed to set X-Forwarded-* headers (uvicorn).
FORWARDED_ALLOW_IPS=127.0.0.1

# Object storage. On AWS leave S3_ENDPOINT_URL empty and the keys unset to use the
# instance/task IAM role. For an S3-compatible service, set its endpoint (it must be
# reachable by browsers: uploads and downloads use presigned URLs) and its keys.
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRE_SECONDS=3600

# Pipeline execution on AWS Batch. false: runs are recorded as pending and never executed.
AWS_BATCH_ENABLED=false
# AWS_BATCH_JOB_QUEUE=
# AWS_BATCH_JOB_DEFINITION=
# NEXTFLOW_WORK_DIR=s3://<bucket>/nextflow-work
# NEXTFLOW_PROFILE=awsbatch
# NEXTFLOW_CONFIG_URI=
# Public URL of this API, used by Nextflow to post weblog events.
# PUBLIC_API_URL=https://titerlane.example.org

# Accounts and workspaces
BOOTSTRAP_REGISTRATION_ENABLED=false
WORKSPACE_CREATION_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
